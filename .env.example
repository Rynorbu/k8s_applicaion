# Copy to .env (or run `npm run secrets:generate`) and adjust.
# Values below are DEVELOPMENT defaults - never use them in production.

NODE_ENV=development
LOG_LEVEL=info
APP_URL=http://localhost:3000
ADMIN_EMAILS=admin@spendwise.local
COOKIE_SECURE=false

# Shared secret for service-to-service (/internal) calls (>= 24 chars)
INTERNAL_API_TOKEN=dev-only-internal-token-change-me-0123456789

# Base64-encoded PKCS#8 PEM RSA private key used to sign JWTs.
# Empty in development = ephemeral key generated at startup (tokens invalidated on restart).
JWT_PRIVATE_KEY=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres-dev
SERVICE_DB_PASSWORD=spendwise-dev-db
RABBITMQ_USER=spendwise
RABBITMQ_PASSWORD=spendwise-dev
REDIS_PASSWORD=spendwise-dev
GRAFANA_PASSWORD=admin-dev

# Optional: Claude-written narratives in AI insights (falls back to a template when empty)
ANTHROPIC_API_KEY=

# Set to false in offline/CI environments to skip fetching ECB exchange rates
RATES_REFRESH_ENABLED=true

# Host port overrides (if 5432/6379/5672 are already used locally)
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
RABBITMQ_HOST_PORT=5672

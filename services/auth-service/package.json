{
  "name": "@spendwise/auth-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Authentication: registration, login, JWT access tokens, rotating refresh tokens, password reset, sessions, JWKS",
  "scripts": {
    "start": "node --import @spendwise/common/tracing src/index.js",
    "dev": "node --watch --import @spendwise/common/tracing src/index.js",
